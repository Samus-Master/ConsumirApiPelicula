@using ApiPeliculas.Models.DTO
@using ConsumirApiPelicula.Models.ViewModel

@model HomeViewModel

@{
	ViewData["Title"] = "Gatonplayseries";
	var totalItems = Model.Sliders.Count();
}

@section Styles {
	<link rel="stylesheet" href="~/lib/glide/glide.core.min.css"  asp-append-version="true"/>
	<link rel="stylesheet" href="~/lib/glide/glide.theme.min.css" asp-append-version="true" />
}

<style>
	.containerFilterLetter {
		height: 30px;
		width: 35px;
		background-color: dimgray;
	}

		.containerFilterLetter:hover {
			background-color: aliceblue;
		}

			.containerFilterLetter:hover .containerFilterLetter-word {
				color: red !important
			}



	.glide {
		height: clamp(140px, 30vw, 349px);
		overflow: hidden;
	}

	.glide__track,
	.glide__slides,
	.glide__slide,
	.card {
		height: 100%;
	}

	#sliderItemImage {
		height: 100%;
		object-fit: cover;
	}

</style>

<nav class="d-flex gap-1" style="overflow-y:hidden; overflow-x:auto; white-space:nowrap;">
	@for (char letra = 'A'; letra <= 'Z'; letra++)
	{
		<div class="d-inline-flex flex-shrink-0 rounded justify-content-center align-items-center btn containerFilterLetter">
			<a class="text-decoration-none text-light containerFilterLetter-word">@letra</a>
		</div>
	}
</nav>

<section>
	<div class="mt-5">




		<div class="glide">
			<div class="glide__track " data-glide-el="track">
				<ul class="glide__slides ">
					@foreach (var item in Model.Sliders)
					{
						<li class="glide__slide">
							<div class="card position-relative">
								<img src="@item.Pelicula.RutaImagen" class="card-img-top" id="sliderItemImage" alt="Imagen 1">
								<div class="card-body position-absolute d-flex w-100 h-100 z-3 p-0">

									<div class="align-self-end w-100 ps-3">
										<h5 class="card-title z-3">@item.Pelicula.Nombre</h5>
										<p class="card-text">Descripción opcional</p>
									</div>
								</div>
							</div>
						</li>
					}
				</ul>
			</div>

			<!-- FLECHAS -->
			<div class="glide__arrows" data-glide-el="controls">
				<button class="glide__arrow glide__arrow--left" data-glide-dir="<" aria-label="Anterior">«</button>
				<button class="glide__arrow glide__arrow--right" data-glide-dir=">" aria-label="Siguiente">»</button>

			</div>


			<!-- INDICADORES -->
			<div class="glide__bullets" data-glide-el="controls[nav]">
				
				@for (var i = 0; i < totalItems; i++)
				{
					<button class="glide__bullet" data-glide-dir="=@i"></button>
				}
				@* <button class="glide__bullet" data-glide-dir="=0"></button> *@
				@* <button class="glide__bullet" data-glide-dir="=1"></button> *@
				@* <button class="glide__bullet" data-glide-dir="=2"></button> *@
				<!-- Puedes generarlos con Razor si tu lista es dinámica -->
			</div>

		</div>



		@* <div class="carousel-item active h-100 w-100">
						<div class="row g-3 h-100">
									<div class="col-6 h-100">
								<img src="@item.Pelicula.RutaImagen" class=" h-100 w-75 img-fluid " alt="..." style=" object-fit: cover;">
							</div>

						</div>
						<div class="carousel-caption d-none d-md-block">
							<h5>@item.Pelicula.Nombre</h5>
							<p>@item.Pelicula.Clasificacion</p>
						</div>

					</div> *@



		@* 	<div class="carousel-item active h-100 w-100">
					<div class="row g-3 h-100">
						<div class="col-6 h-100">
							<img src="~/imagenes/Dieciseis/4c419d04-9b16-4490-b41e-061c4b181f2a.jpg" class=" h-100 w-75 img-fluid " alt="..." style=" object-fit: cover;">
						</div>
						<div class="col-6 h-100">
							<img src="~/imagenes/Dieciseis/4c419d04-9b16-4490-b41e-061c4b181f2a.jpg" class=" h-100 w-75 img-fluid" alt="..." style=" object-fit: cover;">
						</div>
					</div>
					<div class="carousel-caption d-none d-md-block">
						<h5>First slide label</h5>
						<p>Some representative placeholder content for the first slide.</p>
					</div>

				</div>

				<div class="carousel-item">
					<img src="..." class="d-block w-100" alt="...">
					<div class="carousel-caption d-none d-md-block">
						<h5>Second slide label</h5>
						<p>Some representative placeholder content for the second slide.</p>
					</div>
				</div>
				<div class="carousel-item">
					<img src="..." class="d-block w-100" alt="...">
					<div class="carousel-caption d-none d-md-block">
						<h5>Third slide label</h5>
						<p>Some representative placeholder content for the third slide.</p>
					</div>
				</div> *@

	</div>
</section>

@section Scripts {
	<script src="~/lib/glide/glide.min.js"></script>

	<script>
		new Glide('.glide', {
			  type: 'carousel',
				  autoplay: 3000, // cambia cada 3 segundos
					  animationDuration: 800, // suaviza la transición
				  rewind: false, // que vuelva al primer slide
			breakpoints: {
			768: {
			  perView: 1
			},
			1024: {
			  perView: 2
			},
			1400: {
			  perView: 3
			}
		  },
		  perView: 4,
		  focusAt: 'center'
		}).mount();

	</script>
}
