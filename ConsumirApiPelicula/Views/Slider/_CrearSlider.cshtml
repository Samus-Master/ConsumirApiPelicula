@using ConsumirApiPelicula.Models.ViewModel
@model SliderViewModel;
@{
}

<!-- Modal -->
<div class="modal fade" id="modalCrearSlider" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="false">
	<div class="modal-dialog modal-xl modal-fullscreen-sm-down">
		<div class="modal-content ">
			<div class="modal-header">
				<h5 class="modal-title" id="modalTitle">Slider</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body p-4 ">
				<div asp-validation-summary="ModelOnly"></div>

				<form class="form" method="POST" id="formCreateSlider">

					<div class="row gy-2">
						<input id="id" type="hidden" />

						<div class="form-group">
							<label asp-for="SliderDTO.Estado" asp class="form-check-label"></label>
							<input type="checkbox" asp-for="SliderDTO.Estado" class="form-check-input" />
							<span asp-validation-for="SliderDTO.Estado" class="alert-danger"></span>
						</div>

						<div class="form-group " id="dropdownCategoriasWithPelicula">
							<label asp-for="@Model.SliderDTO.PeliculaId" class="col-form-label"></label>
							@* @Html.DropDownListFor(model => model.SliderDTO.PeliculaId, Model.ListaCategorias, new { @class = "form-select", data_placeholder = "Seleccione las categorias" }) *@
							@Html.DropDownListFor(m => m.SliderDTO.PeliculaId,
																Model.ListaCategorias,
																new { @class = "form-select"})

							<span asp-validation-for="SliderDTO.PeliculaId" class="alert-danger"></span>
						</div>

					</div>
				</form>

			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Volver</button>
				<button type="button" id="modalBtnAceptar" class="btn btn-primary">Aceptar</button>
			</div>
		</div>
	</div>
</div>